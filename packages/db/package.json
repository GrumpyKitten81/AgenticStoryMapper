{
  "name": "@storymapper/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-db-migrations.mjs db",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude \"**/dist/**\" --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "test:coverage": "vitest run --exclude \"**/dist/**\" --coverage"
  },
  "dependencies": {
    "@storymapper/contracts": "workspace:*",
    "@storymapper/core": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "vitest": "^4.1.12",
    "@storymapper/importers": "workspace:*",
    "@storymapper/server": "workspace:*"
  }
}
