+    void invokeMcpTool(() => registry.call(params?.name, args, () => { throw new DomainError("validation", "Request validation failed."); }))
+      .then((result) => transport.send({ jsonrpc: "2.0", id: message.id, result: mcpServer.server.projectCallToolResult(result, undefined) }, { relatedRequestId: message.id }))
+      .catch((error: unknown) => { server.log.error({ err: error }, "MCP error response failed"); });
+  };
+}
