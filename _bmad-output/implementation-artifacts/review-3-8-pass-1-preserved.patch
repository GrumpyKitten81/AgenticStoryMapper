diff --git a/apps/server/src/mcp/tools/audit-tool-call.ts b/apps/server/src/mcp/tools/audit-tool-call.ts
new file mode 100644
--- /dev/null
+++ b/apps/server/src/mcp/tools/audit-tool-call.ts
@@ -0,0 +1,50 @@
+import { createHash, randomUUID } from "node:crypto";
+import { DomainError, mcpToolNameSchema, toErrorResponse, uuidSchema, type McpToolResult, type ToolCallMetadata } from "@storymapper/contracts";
+import { asDomainError } from "@storymapper/server/application/errors";
+import { resolveAuditProjectIds } from "@storymapper/server/mcp/tools/project-scopes";
+import type { RegistrationContext } from "@storymapper/server/mcp/tools/register-tools";
+
+function hashJson(value: unknown): string {
+  return createHash("sha256").update(JSON.stringify(value) ?? "undefined").digest("hex");
+}
+
+function affectedIds(value: unknown): string[] {
+  if (!value || typeof value !== "object") return [];
+  if (Array.isArray(value)) return value.flatMap(affectedIds);
+  return Object.entries(value).flatMap(([key, item]) => {
+    if (key === "before" || key === "after" || key === "toolCall" || key === "activityEvents") return [];
+    if (key === "id" || /Ids?$/.test(key)) return (Array.isArray(item) ? item : [item]).filter((id): id is string => typeof id === "string" && uuidSchema.safeParse(id).success);
+    return affectedIds(item);
+  });
+}
+
+function inputIds(value: unknown): string[] {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return [];
+  return Object.entries(value).flatMap(([key, item]) => key === "patch" ? inputIds(item) : /Ids?$/.test(key) ? (Array.isArray(item) ? item : [item]).filter((id): id is string => typeof id === "string" && uuidSchema.safeParse(id).success) : []);
+}
+
+export async function auditToolCall(context: RegistrationContext, name: unknown, input: unknown, invoke: (recordProjectIds?: (projectIds: string[]) => void) => Promise<McpToolResult>): Promise<McpToolResult> {
+  const validName = mcpToolNameSchema.safeParse(name);
+  let projectIds: string[] = [];
+  const base = { toolName: typeof name === "string" && /^[A-Za-z][A-Za-z0-9_.-]{0,99}$/.test(name) ? name : "InvalidToolName", inputHash: hashJson(input), affectedEntityIds: validName.success ? [...new Set(inputIds(input))] : [] };
+  let result: McpToolResult | undefined;
+  let failure: ReturnType<typeof asDomainError> | undefined;
+  let metadata: ToolCallMetadata;
+  try {
+    projectIds = validName.success ? resolveAuditProjectIds(context.repository, input) : [];
+    result = await invoke((resolved) => {
+      const record = input && typeof input === "object" ? input as Record<string, unknown> : {};
+      const mismatchedOwner = typeof record.projectId === "string" && (record.storyMapId || record.personaId) && projectIds.length && !projectIds.includes(record.projectId);
+      if (!mismatchedOwner) projectIds = resolved;
+    });
+    metadata = { ...base, outcome: "ok", outputHash: hashJson(result), affectedEntityIds: [...new Set([...base.affectedEntityIds, ...affectedIds(result)])] };
+  } catch (error) {
+    failure = asDomainError(error);
+    if (failure.code === "internal") failure = new DomainError("internal", "An internal error occurred.", { errorId: uuidSchema.safeParse(failure.details?.errorId).data ?? randomUUID() });
+    const { statusCode: _status, ...envelope } = toErrorResponse(failure);
+    metadata = { ...base, outcome: failure.code === "internal" ? "error" : "rejected", outputHash: hashJson(envelope), ...(failure.code === "internal" ? { errorId: failure.details?.errorId as string } : { rejectionReason: failure.code }) };
+  }
+  context.unitOfWork.run(context.actor, ({ repository }) => repository.logMcpToolCall({ projectId: projectIds.length === 1 ? projectIds[0]! : null, metadata }));
+  if (failure) throw failure;
+  return result!;
+}
