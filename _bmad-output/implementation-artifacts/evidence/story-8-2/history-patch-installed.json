{
  "version": "1.162.0",
  "sourceSha256": "ec4db26c362589f0753b72b27d1d4f2a428e38d769a66fb2861b2d660f8bc73e",
  "patchSha256": "7a7d8521994572da0a237f77f98c6468309b95cf17d9df43255b2b6bc9d0d369",
  "snippets": [
    "",
    "  const onPushPopEvent = async () => {",
    "    ignoreNextBeforeUnload = false",
    "    if (ignoreNextPop) {",
    "      ignoreNextPop = false",
    "      return",
    "    }",
    "",
    "    const nextLocation = parseLocation()",
    "    const delta =",
    "      nextLocation.state[stateIndexKey] - currentLocation.state[stateIndexKey]",
    "    const isForward = delta === 1",
    "    const isBack = delta === -1",
    "    const isGo = (!isForward && !isBack) || nextPopIsGo",
    "    nextPopIsGo = false",
    "",
    "    const action = isGo ? 'GO' : isBack ? 'BACK' : 'FORWARD'",
    "    const notify: SubscriberHistoryAction = isGo",
    "      ? {",
    "          type: 'GO',",
    "          index: delta,",
    "        }",
    "      : {",
    "          type: isBack ? 'BACK' : 'FORWARD',",
    "        }",
    "",
    "    if (skipBlockerNextPop) {",
    "      skipBlockerNextPop = false",
    "    } else {",
    "      const blockers = _getBlockers()",
    "      if (typeof document !== 'undefined' && blockers.length) {",
    "        for (const blocker of blockers) {",
    "          const isBlocked = await blocker.blockerFn({",
    "            currentLocation,",
    "            nextLocation,",
    "            action,",
    "          })",
    "          if (isBlocked) {",
    "            const restoreDelta = currentLocation.state[stateIndexKey] - parseLocation().state[stateIndexKey]",
    "            if (restoreDelta) {",
    "              ignoreNextPop = true",
    "              win.history.go(restoreDelta)",
    "            }",
    "            history.notify(notify)",
    "            return",
    "          }",
    "        }",
    "      }",
    "    }",
    "",
    "    const resumeDelta = nextLocation.state[stateIndexKey] - parseLocation().state[stateIndexKey]",
    "    if (resumeDelta) {",
    "      ignoreNextPop = true",
    "      win.history.go(resumeDelta)",
    "    }",
    "    currentLocation = nextLocation",
    "    history.notify(notify)",
    "  }"
  ],
  "decision": "retain",
  "reason": "Installed source requires the patch to reset beforeunload suppression and calculate exact restore/resume traversal deltas. No Router major required for advisory repairs.",
  "finalSourceSha256": "ec4db26c362589f0753b72b27d1d4f2a428e38d769a66fb2861b2d660f8bc73e",
  "finalSourceMatches": true
}
