diff --git a/packages/db/src/repositories/tool-proposals-repository.ts b/packages/db/src/repositories/tool-proposals-repository.ts
new file mode 100644
index 0000000..053c619
--- /dev/null
+++ b/packages/db/src/repositories/tool-proposals-repository.ts
@@ -0,0 +1,171 @@
+import { createHash, randomUUID } from "node:crypto";
+import { and, eq } from "drizzle-orm";
+import { DomainError, githubBoardProposalRequestSchema, copyStoryMapProposalRequestSchema } from "@storymapper/contracts";
+import type { ChangeOperation, ChangeSet, CopyStoryMapProposalRequest, GitHubBoardIssue, GitHubBoardProposalRequest, Card } from "@storymapper/contracts";
+import { createChangeSet } from "@storymapper/core";
+import { copyStoryMap, mapFingerprint } from "@storymapper/db/repositories/map-copy-repository";
+import type { StoryMapperRepository } from "@storymapper/db/repositories/storymapper-repository";
+import { cards, githubLinks, remoteWorkItemLinks } from "@storymapper/db/schema";
+
+export function proposeStoryMapCopy(this: StoryMapperRepository<"transaction">, input: CopyStoryMapProposalRequest): ChangeSet {
+  this.assertWritable();
+  const source = this.getStoryMapOrThrow(input.sourceStoryMapId);
+  return this.createChangeSet(createChangeSet({ id: randomUUID(), projectId: source.projectId,
+    title: `Copy ${source.name} to ${input.targetName}`, source: "import", operations: [{
+      op: "create", entity: "storyMapCopy", entityId: randomUUID(),
+      after: { input, expected: fingerprints(this, [source.id]) },
+      reason: "Copy the complete Story Map and its owned relationships."
+    }]
+  }));
+}
+
+export function proposeGitHubBoard(this: StoryMapperRepository<"transaction">, input: GitHubBoardProposalRequest): ChangeSet {
+  this.assertWritable();
+  if (!this.listProjects().some((project) => project.id === input.projectId)) throw new DomainError("not_found", "Project not found.");
+  const mapIds = input.cleanup ? this.listStoryMaps(input.projectId).map((map) => map.id) : input.storyMapId ? [input.storyMapId] : [];
+  for (const mapId of mapIds) if (this.getStoryMapOrThrow(mapId).projectId !== input.projectId) throw new DomainError("validation", "Story Map belongs to another Project.");
+  for (const cardId of input.removeCardIds) if (this.getCard(cardId)?.storyMapId !== input.storyMapId) throw new DomainError("validation", "Removal Card does not belong to the sync Story Map.");
+  const existing = input.storyMapId ? existingIssueCards(this, input.storyMapId) : new Map<string, Card>();
+  if (input.issues.some((issue) => input.removeCardIds.includes(existing.get(issueKey(issue.repository, issue.number))?.id ?? ""))) throw new DomainError("validation", "An imported issue cannot also be removed.");
+  return this.createChangeSet(createChangeSet({ id: randomUUID(), projectId: input.projectId,
+    title: `${input.storyMapId ? "Sync" : "Import"} GitHub board: ${input.storyMapName}`, source: "import", operations: [{
+      op: "create", entity: "githubBoardImport", entityId: randomUUID(),
+      after: { input, expected: fingerprints(this, mapIds) }, reason: `Read-only GitHub source: ${input.boardUrl}`
+    }]
+  }));
+}
+
+export function applyToolProposal(repository: StoryMapperRepository<"transaction">, changeSet: ChangeSet, operation: ChangeOperation): void {
+  if (repository.actor.actorType !== "human") throw new DomainError("protected", "Local data tool proposals require human application.");
+  const after = operation.after as { input: unknown; expected: Record<string, string> };
+  if (!after || !after.expected) throw new DomainError("validation", "Tool proposal context is missing.");
+  for (const [id, expected] of Object.entries(after.expected)) {
+    if (repository.getStoryMapOrThrow(id).projectId !== changeSet.projectId || mapFingerprint.call(repository as unknown as StoryMapperRepository, id) !== expected) throw new DomainError("conflict", "Story Map changed after the proposal; create a new proposal.");
+  }
+  if (operation.entity === "storyMapCopy") {
+    const input = copyStoryMapProposalRequestSchema.parse(after.input);
+    if (!after.expected[input.sourceStoryMapId] || repository.getStoryMapOrThrow(input.sourceStoryMapId).projectId !== changeSet.projectId) throw new DomainError("validation", "Copy proposal source scope is missing.");
+    copyStoryMap.call(repository, input.sourceStoryMapId, input.targetName, operation.entityId);
+    return;
+  }
+  const input = githubBoardProposalRequestSchema.parse(after.input);
+  if (input.projectId !== changeSet.projectId) throw new DomainError("validation", "Tool proposal Project mismatch.");
+  if (input.storyMapId && !after.expected[input.storyMapId]) throw new DomainError("validation", "Sync proposal source scope is missing.");
+  if (input.cleanup && JSON.stringify(repository.listStoryMaps(input.projectId).map((map) => map.id).sort()) !== JSON.stringify(Object.keys(after.expected).sort())) throw new DomainError("conflict", "Project Story Maps changed after the cleanup proposal.");
+  applyGitHubBoard(repository, input);
+}
+
+function fingerprints(repository: StoryMapperRepository<"transaction">, ids: string[]): Record<string, string> {
+  return Object.fromEntries(ids.map((id) => [id, mapFingerprint.call(repository as unknown as StoryMapperRepository, id)]));
+}
+
+function applyGitHubBoard(repository: StoryMapperRepository<"transaction">, input: GitHubBoardProposalRequest): void {
+  if (input.cleanup) for (const map of repository.listStoryMaps(input.projectId)) repository.deleteStoryMap(map.id);
+  const map = input.storyMapId ? repository.getStoryMapOrThrow(input.storyMapId) : repository.createStoryMap({ projectId: input.projectId, name: input.storyMapName, description: `Imported from ${input.boardUrl}` });
+  if (map.projectId !== input.projectId) throw new DomainError("validation", "Story Map Project mismatch.");
+  for (const id of input.removeCardIds) {
+    if (repository.getCard(id)?.storyMapId !== map.id) throw new DomainError("conflict", "Removal Card changed after proposal.");
+    removeBoardCard(repository, id);
+  }
+  const existing = existingIssueCards(repository, map.id);
+  const newIssues = input.issues.filter((issue) => !existing.has(issueKey(issue.repository, issue.number)));
+  const parking = newIssues.length ? parkingCards(repository, map.id) : undefined;
+  const connections = boardConnections(repository, input);
+  for (const issue of [...input.issues].sort((left, right) => levelOrder(left) - levelOrder(right) || issueKey(left.repository, left.number).localeCompare(issueKey(right.repository, right.number)))) {
+    upsertIssueCard(repository, map.id, issue, existing, parking);
+  }
+  for (const issue of input.issues) {
+    const card = existing.get(issueKey(issue.repository, issue.number))!;
+    if (parking && newIssues.includes(issue) && card.level !== "activity") {
+      const parent = issue.parentRepository && issue.parentNumber ? existing.get(issueKey(issue.parentRepository, issue.parentNumber)) : undefined;
+      const parentId = card.level === "step" ? parent?.level === "activity" ? parent.id : parking.activity : parent?.level === "step" ? parent.id : parking.step;
+      repository.moveCard(card.id, { parentId, position: repository.nextSiblingPosition(map.id, parentId) });
+    }
+    upsertIssueLinks(repository, card.id, connections.get(issue.repository)!, issue);
+  }
+}
+
+function upsertIssueCard(repository: StoryMapperRepository<"transaction">, mapId: string, issue: GitHubBoardIssue, existing: Map<string, Card>, parking: { activity: string; step: string } | undefined): void {
+  const key = issueKey(issue.repository, issue.number);
+  const status = issue.state === "closed" ? "done" : issue.labels.includes("status:active") ? "active" : "todo";
+  const title = issue.title.replace(/^[A-Z][A-Z0-9]*-\d+:\s*/, "");
+  const current = existing.get(key);
+  if (current) {
+    if (current.title === title && current.description === issue.body && current.status === status && (current.assignee ?? null) === issue.assignee) return;
+    repository.db.update(cards).set({ title, description: issue.body, status, assignee: issue.assignee, updatedAt: new Date().toISOString() }).where(eq(cards.id, current.id)).run();
+    const updated = repository.getCard(current.id)!;
+    repository.writeCardVersion(updated);
+    repository.logActivity(repository.getStoryMapOrThrow(mapId).projectId, "card.updated", "card", current.id, current, updated);
+    return;
+  }
+  const level = levelOrder(issue) === 0 ? "activity" : levelOrder(issue) === 1 ? "step" : "story";
+  const card = repository.createCard({ storyMapId: mapId, level, parentId: level === "activity" ? null : level === "step" ? parking!.activity : parking!.step,
+    title, description: issue.body, status, ...(issue.assignee ? { assignee: issue.assignee } : {}) }, "import");
+  existing.set(key, card);
+}
+
+function boardConnections(repository: StoryMapperRepository<"transaction">, input: GitHubBoardProposalRequest): Map<string, string> {
+  const connections = repository.listConnectorConnections(input.projectId);
+  return new Map([...new Set(input.issues.map((issue) => issue.repository))].map((name) => {
+    const [owner, repo] = name.split("/");
+    const existing = connections.find((connection) => connection.provider === "github" && connection.owner === owner && connection.repository === repo);
+    const connection = existing ? repository.updateConnectorConnection(existing.id, { readOnly: true })! : repository.createConnectorConnection({
+      projectId: input.projectId, provider: "github", name, authMode: "token", owner: owner!, repository: repo!, readOnly: true,
+      statusMapping: [{ localStatus: "todo", remoteState: "open", labels: ["status:todo"] }, { localStatus: "active", remoteState: "open", labels: ["status:active"] }, { localStatus: "done", remoteState: "closed", labels: ["status:done"] }]
+    });
+    return [name, connection.id];
+  }));
+}
+
+function existingIssueCards(repository: StoryMapperRepository<"transaction">, mapId: string): Map<string, Card> {
+  const cards = new Map<string, Card>();
+  for (const link of repository.listGitHubLinksForStoryMap(mapId)) {
+    if (!link.cardId || !link.issueNumber) continue;
+    const key = issueKey(link.repo, link.issueNumber);
+    if (cards.has(key)) throw new DomainError("conflict", "Multiple Cards refer to the same GitHub issue.");
+    const card = repository.getCard(link.cardId);
+    if (card) cards.set(key, card);
+  }
+  return cards;
+}
+
+function parkingCards(repository: StoryMapperRepository<"transaction">, mapId: string): { activity: string; step: string } {
+  const cards = repository.listCards(mapId);
+  const activity = cards.find((card) => card.level === "activity" && !card.parentId && card.title === "Parking lot") ?? repository.createCard({ storyMapId: mapId, level: "activity", title: "Parking lot" }, "import");
+  const step = cards.find((card) => card.level === "step" && card.parentId === activity.id && card.title === "Parking lot") ?? repository.createCard({ storyMapId: mapId, parentId: activity.id, level: "step", title: "Parking lot" }, "import");
+  return { activity: activity.id, step: step.id };
+}
+
+function upsertIssueLinks(repository: StoryMapperRepository<"transaction">, cardId: string, connectionId: string, issue: GitHubBoardIssue): void {
+  const card = repository.getCard(cardId)!;
+  const link = repository.listGitHubLinksForStoryMap(card.storyMapId).find((entry) => entry.cardId === cardId && entry.repo === issue.repository && entry.issueNumber === issue.number);
+  const values = { repo: issue.repository, issueNumber: issue.number, url: issue.url, syncState: "synced" as const };
+  if (link) {
+    repository.db.update(githubLinks).set({ ...values, milestone: issue.milestone }).where(eq(githubLinks.id, link.id)).run();
+    repository.logActivity(repository.getStoryMapOrThrow(card.storyMapId).projectId, "githubLink.updated", "githubLink", link.id, link, repository.getGitHubLink(link.id));
+  } else repository.createGitHubLink({ cardId, ...values, ...(issue.milestone ? { milestone: issue.milestone } : {}) });
+  const remote = repository.db.select().from(remoteWorkItemLinks).where(and(eq(remoteWorkItemLinks.cardId, cardId), eq(remoteWorkItemLinks.connectionId, connectionId))).get();
+  const baseline = { connectionId, provider: "github", cardId, remoteId: String(issue.number), remoteNumber: issue.number,
+    url: issue.url, titleHash: hash(issue.title), bodyHash: hash(issue.body), remoteState: issue.state, labelsJson: JSON.stringify(issue.labels),
+    milestone: issue.milestone, remoteParentNumber: issue.parentNumber, syncState: "synced", lastSyncedAt: new Date().toISOString() };
+  const id = remote?.id ?? randomUUID();
+  if (remote) repository.db.update(remoteWorkItemLinks).set(baseline).where(eq(remoteWorkItemLinks.id, id)).run();
+  else repository.db.insert(remoteWorkItemLinks).values({ id, ...baseline, parentOverrideLocal: false }).run();
+  repository.logActivity(repository.getStoryMapOrThrow(card.storyMapId).projectId, `remoteWorkItemLink.${remote ? "updated" : "created"}`, "remoteWorkItemLink", id, remote, baseline);
+}
+
+function removeBoardCard(repository: StoryMapperRepository<"transaction">, cardId: string): void {
+  const card = repository.getCard(cardId)!;
+  const projectId = repository.getStoryMapOrThrow(card.storyMapId).projectId;
+  for (const child of repository.listCards(card.storyMapId).filter((entry) => entry.parentId === cardId)) {
+    repository.db.update(cards).set({ parentId: card.parentId, updatedAt: new Date().toISOString() }).where(eq(cards.id, child.id)).run();
+    const updated = repository.getCard(child.id)!;
+    repository.writeCardVersion(updated);
+    repository.logActivity(projectId, "card.rehomed", "card", child.id, child, updated);
+  }
+  repository.deleteCard(cardId, { strategy: "unassign" });
+}
+
+function issueKey(repository: string, number: number): string { return `${repository.toLowerCase()}#${number}`; }
+function levelOrder(issue: GitHubBoardIssue): number { return issue.issueType?.toLowerCase() === "epic" ? 0 : issue.issueType?.toLowerCase() === "feature" ? 1 : 2; }
+function hash(value: string): string { return createHash("sha256").update(value).digest("hex"); }
