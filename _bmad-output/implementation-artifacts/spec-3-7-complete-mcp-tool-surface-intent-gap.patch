new file mode 100644
index 0000000..563ff13
--- /dev/null
+++ b/scripts/capability-artifacts.mjs
@@ -0,0 +1,59 @@
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+
+export const capabilityArtifactPaths = {
+  tools: "packages/mcp/src/tool-definitions/capabilities.ts",
+  documentation: "docs/mcp-tools.md"
+};
+const retainedMetadata = JSON.parse(readFileSync(fileURLToPath(new URL("./mcp-tool-metadata.json", import.meta.url)), "utf8"));
+const githubTools = new Set(["PlanWorkItems", "ResolveSyncConflict"]);
+
+export function toolMetadata(manifest) {
+  return manifest.capabilities.filter((capability) => capability.tool).map((capability) => {
+    const retained = retainedMetadata.find((tool) => tool.name === capability.tool);
+    return {
+      name: capability.tool,
+      description: retained?.description ?? `${humanize(capability.name)}.`,
+      permission: retained?.permission ?? (githubTools.has(capability.tool) ? "github" : capability.tool === "CreateAiProposal" ? "proposal" : capability.kind)
+    };
+  });
+}
+
+function humanize(name) {
+  const words = name.replace(/([a-z\d])([A-Z])/g, "$1 $2");
+  return words[0].toUpperCase() + words.slice(1);
+}
+
+export function serializeToolDefinitions(manifest) {
+  return `export const generatedMcpToolDefinitions = ${JSON.stringify(toolMetadata(manifest), null, 2)} as const;\n`;
+}
+
+export function serializeToolDocumentation(manifest) {
+  const tools = toolMetadata(manifest);
+  const descriptions = new Map(tools.map((tool) => [tool.name, tool]));
+  const eligible = manifest.capabilities.filter((capability) => capability.tool);
+  const humanOnly = manifest.capabilities.filter((capability) => capability.kind === "human-only");
+  const writes = manifest.capabilities.filter((capability) => capability.kind === "write");
+  const toolRows = eligible.map((capability) => {
+    const tool = descriptions.get(capability.tool);
+    return `| \`${tool.name}\` | ${tool.permission} | \`${capability.name}\` | ${tool.description} |`;
+  });
+  const humanRows = humanOnly.map((capability) => `| \`${capability.name}\` | ${capability.route ? `\`${capability.route}\`` : "—"} |`);
+  return [
+    "# MCP Tools", "",
+    "Reproducing statement: Generate the complete MCP tool inventory, human-only boundary and deferred operation-registry check from the application capability manifest for Story 3.7. Date: 2026-10-08. Version: 2.", "",
+    "Generated by `corepack pnpm generate-capabilities` and during `corepack pnpm build`. `corepack pnpm check-capabilities` detects stale artifacts; runtime parity tests compare this inventory with actual registered tools.", "",
+    "Permissions use every touched Project's safety switches: reads and proposals require agent access; writes require protection off; GitHub calls also require the GitHub switch. Runtime-wide reads filter inaccessible Projects. Inputs reuse the contracts' Zod schemas. `ApplyChangeSet` applies only an already human-approved ChangeSet.", "",
+    "## Tool inventory", "",
+    `The manifest exposes ${tools.length} tools.`, "",
+    "| Tool | Permission | Use case | Description |", "| --- | --- | --- | --- |", ...toolRows, "",
+    "## Human-only boundary", "",
+    "Agents cannot create Projects, change safety switches or connector credentials/configuration, approve or reject ChangeSets, restore or create restore points on demand, import or export Project archives, or perform UI checklist bookkeeping. Read-only safety and public connector metadata remain available through tools.", "",
+    "| Use case | HTTP route |", "| --- | --- |", ...humanRows, "",
+    "## Known gap: operation-registry membership", "",
+    "Parity enforces descriptors, routes and MCP tool mappings. Membership of write use cases in a typed ChangeOperation registry remains an explicit gap: Stories 4.4–4.5 implement the registry, Story 4.6 implements its executor, and Story 4.7 routes agent writes through ChangeSets and empties this list. Existing actor-aware application writes remain the staged implementation; this inventory does not establish ChangeSet-first compliance.", "",
+    `Write use cases awaiting the membership check: ${writes.map((capability) => `\`${capability.name}\``).join(", ")}.`, "",
+    "## Changelog", "",
+    "- 2026-10-08, version 2: Generate the complete inventory and human-only list; record the Epic 4 operation-registry gap.", ""
+  ].join("\n");
+}
