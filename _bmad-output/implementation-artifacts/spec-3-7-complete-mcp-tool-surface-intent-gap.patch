@@ -4,13 +4,13 @@ import type { ApplicationDeps } from "@storymapper/server/application/deps";
 import { buildAiProposalChangeSet } from "@storymapper/server/services/ai-proposal-change-set";
 import { defaultAiFunctionTemplates } from "@storymapper/server/services/default-ai-templates";
 
-export const listAiTemplatesDescriptor: CapabilityDescriptor = { name: "listAiTemplates", kind: "read", route: "GET /api/ai/templates" };
+export const listAiTemplatesDescriptor: CapabilityDescriptor = { name: "listAiTemplates", kind: "read", route: "GET /api/ai/templates", tool: "ListAiTemplates" };
 export function listAiTemplates(_deps: ApplicationDeps, actor: ActorContext): AiTemplatesResponse {
   requireActor(actor);
   return { templates: defaultAiFunctionTemplates };
 }
 
-export const createAiProposalDescriptor: CapabilityDescriptor = { name: "createAiProposal", kind: "write", route: "POST /api/ai/proposals" };
+export const createAiProposalDescriptor: CapabilityDescriptor = { name: "createAiProposal", kind: "write", route: "POST /api/ai/proposals", tool: "CreateAiProposal" };
 export function createAiProposal(deps: ApplicationDeps, actor: ActorContext, input: CreateAiProposalRequest): AiProposalResponse {
   requireActor(actor);
   return deps.unitOfWork.run(actor, ({ repository }) => ({ changeSet: repository.createChangeSet(buildAiProposalChangeSet(repository, input)) }));
