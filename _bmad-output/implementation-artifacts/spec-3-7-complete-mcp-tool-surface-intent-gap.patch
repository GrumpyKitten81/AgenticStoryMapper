+
+export function registerAdditionalCardTools(context: RegistrationContext): void {
+  const { application, actor } = context;
+  registerTool(context, "BulkUpdateCards", async (input) => ({ data: bulkUpdateCards(application, actor, inputs.BulkUpdateCards.parse(input)) }));
+  registerTool(context, "DeleteCard", async (input) => { const parsed = inputs.DeleteCard.parse(input); return { data: deleteCard(application, actor, parsed.cardId, parsed) }; });
+  registerTool(context, "ParkCard", async (input) => { const parsed = inputs.ParkCard.parse(input); return { data: children.parkCard(application, actor, parsed.cardId, parsed) }; });
+  registerTool(context, "UnparkCard", async (input) => ({ data: children.unparkCard(application, actor, inputs.UnparkCard.parse(input).cardId) }));
+  registerTool(context, "GetCardHistory", async (input) => { const { cardId, ...query } = inputs.GetCardHistory.parse(input); return { data: children.getCardHistory(application, actor, cardId, query) }; });
+  registerTool(context, "ListCardAttachments", async (input) => ({ data: children.listCardAttachments(application, actor, inputs.ListCardAttachments.parse(input).cardId) }));
+  registerTool(context, "CreateCardAttachment", async (input) => { const parsed = inputs.CreateCardAttachment.parse(input); return { data: children.createCardAttachment(application, actor, parsed.cardId, parsed) }; });
+  registerTool(context, "DeleteCardAttachment", async (input) => { const parsed = inputs.DeleteCardAttachment.parse(input); return { data: children.deleteCardAttachment(application, actor, parsed.cardId, parsed.attachmentId) }; });
+  registerTool(context, "CreateCardSourceLink", async (input) => { const parsed = inputs.CreateCardSourceLink.parse(input); return { data: children.createCardSourceLink(application, actor, parsed.cardId, parsed) }; });
+  registerTool(context, "DeleteCardSourceLink", async (input) => { const parsed = inputs.DeleteCardSourceLink.parse(input); return { data: children.deleteCardSourceLink(application, actor, parsed.cardId, parsed.chunkId) }; });
+  registerTool(context, "SetCardPersona", async (input) => { const parsed = inputs.SetCardPersona.parse(input); return { data: children.setCardPersona(application, actor, parsed.cardId, parsed.personaId) }; });
+  registerTool(context, "DeleteCardPersona", async (input) => { const parsed = inputs.DeleteCardPersona.parse(input); return { data: children.deleteCardPersona(application, actor, parsed.cardId, parsed.personaId) }; });
+  registerTool(context, "SetCardAnnotation", async (input) => { const parsed = inputs.SetCardAnnotation.parse(input); return { data: children.setCardAnnotation(application, actor, parsed.cardId, parsed.annotationId) }; });
+  registerTool(context, "DeleteCardAnnotation", async (input) => { const parsed = inputs.DeleteCardAnnotation.parse(input); return { data: children.deleteCardAnnotation(application, actor, parsed.cardId, parsed.annotationId) }; });
+  registerLinkTools(context);
+}
+
+function registerLinkTools(context: RegistrationContext): void {
+  const { application, actor } = context;
+  registerTool(context, "CreateGitHubLink", async (input) => ({ data: links.createGitHubLink(application, actor, inputs.CreateGitHubLink.parse(input)) }));
+  registerTool(context, "UpdateGitHubLink", async (input) => { const { linkId, patch } = inputs.UpdateGitHubLink.parse(input); return { data: links.updateGitHubLink(application, actor, linkId, patch) }; });
+  registerTool(context, "DeleteGitHubLink", async (input) => ({ data: links.deleteGitHubLink(application, actor, inputs.DeleteGitHubLink.parse(input).linkId) }));
+  registerTool(context, "GetGitHubSyncHealth", async (input) => ({ data: links.getGitHubSyncHealth(application, actor, inputs.GetGitHubSyncHealth.parse(input).storyMapId) }));
+  registerTool(context, "CreateGitHubIssueDryRun", async (input) => ({ data: links.createGitHubIssueDryRun(application, actor, inputs.CreateGitHubIssueDryRun.parse(input)) }));
+  registerTool(context, "PlanWorkItems", async (input) => ({ data: await planWorkItems(application, actor, inputs.PlanWorkItems.parse(input)) }));
+  registerTool(context, "GetWorkItemSyncHealth", async (input) => ({ data: getWorkItemSyncHealth(application, actor, inputs.GetWorkItemSyncHealth.parse(input).storyMapId) }));
+  registerTool(context, "ResolveSyncConflict", async (input) => { const parsed = inputs.ResolveSyncConflict.parse(input); return { data: await resolveSyncConflict(application, actor, parsed.conflictId, parsed) }; });
